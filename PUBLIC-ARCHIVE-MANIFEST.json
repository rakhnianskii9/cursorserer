{
  "schema_version": 2,
  "archive_kind": "portable-cursor-control-plane",
  "language": "en",
  "install_root": "current_directory",
  "materialization": {
    "interactive": true,
    "mode": "copy_as_is",
    "canonical_files_are_local_only": false,
    "overwrite_requires_confirmation": true,
    "backup_before_write": true
  },
  "release_files": [
    ".gitignore",
    "README.md",
    "INSTALL-WITH-CURSOR.md",
    "LICENSE",
    "NOTICE",
    "PUBLIC-ARCHIVE-MANIFEST.json",
    "CANONICAL-PROTOCOLS.md",
    "MCP-CAPABILITY-MATRIX.md",
    "mcp.json",
    "settings.json",
    "hooks.json",
    "CURSOR-UX.md",
    "CURSOR-MODELS.md",
    "RKX-LOOP-BLUEPRINT-FLOW.md"
  ],
  "public_archive_roots": [
    "agents",
    "commands",
    "hooks",
    "rules",
    "scripts",
    "schemas",
    "reference",
    "skills",
    "loops",
    "runtime/logs"
  ],
  "public_file_patterns": [
    "agents/*.md",
    "commands/*.md",
    "hooks/*.py",
    "hooks/*.sh",
    "hooks/rkx-slack-notify.env",
    "rules/*.mdc",
    "scripts/**",
    "schemas/**",
    "reference/**",
    "skills/**/SKILL.md",
    "skills/**/project-map.md",
    "skills/**/recipes.md",
    "skills/**/project-tenets.md",
    "skills/**/reference.md",
    "loops/README.md",
    "loops/_decisions/**",
    "loops/*.md",
    "runtime/logs/README.md"
  ],
  "public_skill_ids": [
    "browser-ui-evidence",
    "docker-diagnostics",
    "graph-octocode",
    "meta-developer-tools",
    "octocode-code-forensics",
    "orchestration-qa",
    "rkx-loop-bug",
    "rkx-loop-core",
    "rkx-loop-design",
    "rkx-loop-front",
    "rkx-loop-full",
    "rkx-loop-grill-me",
    "rkx-loop-implement",
    "rkx-loop-plan",
    "rkx-loop-validate",
    "rkx-codegraph",
    "rkx-mcp-utilities",
    "rkx-tenets"
  ],
  "exact_public_files": [
    "assets/rkx-loop-flow1_3.png",
    "assets/install-flow.png"
  ],
  "excluded_roots": [
    "prompts",
    "projects",
    "plans",
    "plugins",
    "subagents",
    "sandbox-policies",
    "skills-cursor"
  ],
  "excluded_path_patterns": [
    "reference/system-design-primer/README-ja.md",
    "reference/system-design-primer/README-zh-*.md",
    "reference/system-design-primer/**/README-zh-*.md",
    "reference/system-design-primer/TRANSLATIONS.md",
    "reference/system-design-primer/.github/**",
    "reference/system-design-primer/.gitignore",
    "reference/system-design-primer/generate-epub.sh",
    "reference/system-design-primer/resources/**",
    "skills/**/scripts/**",
    "loops/*/manifest.md",
    "loops/*/slack-notification.json",
    "loops/*/state.md",
    "loops/*/wave-*"
  ],
  "canonical_target_patterns": [
    "agents/*.md",
    "commands/*.md",
    "rules/*.mdc",
    "skills/**/SKILL.md",
    "skills/**/project-map.md",
    "skills/**/recipes.md",
    "skills/**/project-tenets.md",
    "hooks/*.py",
    "hooks/*.sh",
    "hooks.json",
    "mcp.json",
    "settings.json",
    "CURSOR-UX.md",
    "CURSOR-MODELS.md",
    "RKX-LOOP-BLUEPRINT-FLOW.md",
    "reference/blueprint-index.yaml",
    "scripts/*.sh"
  ],
  "required_public_files": [
    "README.md",
    "INSTALL-WITH-CURSOR.md",
    "LICENSE",
    "NOTICE",
    "PUBLIC-ARCHIVE-MANIFEST.json",
    "hooks.json",
    "hooks/rkx_lifecycle_common.py",
    "hooks/rkx_slack_notify.py",
    "hooks/rkx_write_easy_summary.py",
    "scripts/validate-public-control-plane.py",
    "scripts/stage-public-archive.py",
    "schemas/wave-spec-v1.json",
    "schemas/lifecycle-artifact-v1.json",
    "schemas/install-manifest-v1.json",
    "schemas/runtime-inputs-v1.json",
    "assets/rkx-loop-flow1_3.png",
    "assets/install-flow.png",
    "rules/workspace-read-cache.mdc",
    "reference/system-design-primer/README.md",
    "reference/system-design-primer/LICENSE.txt",
    "reference/system-design-primer/.upstream-commit"
  ],
  "binary_review": [
    {
      "path": "assets/rkx-loop-flow1_3.png",
      "sha256": "a539fd26320bf9182aef641ad624545ac16cc51f84cb77673e3b9f701ac1bf75",
      "width": 852,
      "height": 1847,
      "review": "visual-review-complete"
    },
    {
      "path": "assets/install-flow.png",
      "sha256": "cf942d12bf1dce19e254bcf1ced4694699eafed14efef9e5dfaaa3e7d7b06a4a",
      "width": 1064,
      "height": 1478,
      "review": "visual-review-complete"
    }
  ],
  "binary_public_patterns": [
    "reference/system-design-primer/images/**",
    "reference/system-design-primer/solutions/**/*.png",
    "reference/system-design-primer/solutions/**/*.jpg",
    "reference/system-design-primer/solutions/**/*.jpeg",
    "reference/system-design-primer/solutions/**/*.graffle"
  ],
  "excluded_content": [
    "credentials",
    "runtime state",
    "personal paths",
    "legacy orchestration",
    "legacy third-party transport instructions",
    "unpublished customer-specific integrations outside public_skill_ids",
    "non-English vendor translations"
  ],
  "required_public_checks": [
    "no tracked symlinks",
    "no Cyrillic in owned files",
    "no credential literals",
    "no host-specific absolute paths",
    "no mutable latest package tags",
    "no sample filenames in the control-plane surface",
    "all public archive references resolve",
    "exact binary allowlist and recorded hashes",
    "named public provider skills remain English and portable"
  ],
  "optional_capability_policy": {
    "default": "disabled",
    "activation": "explicit_user_confirmation_after_preflight",
    "degraded_behavior": "record_unavailable_and_continue"
  }
}
