{
  "schema_version": 2,
  "archive_kind": "portable-cursor-control-plane",
  "language": "en",
  "install_root": "current_directory",
  "materialization": {
    "interactive": true,
    "source_suffixes": [
      ".example.md",
      ".example.mdc",
      ".example.py",
      "_example.py",
      ".example.sh",
      ".example.json",
      ".example.yaml"
    ],
    "canonical_files_are_local_only": true,
    "overwrite_requires_confirmation": true,
    "backup_before_write": true
  },
  "release_files": [
    ".gitignore",
    "README.md",
    "INSTALL-WITH-CURSOR.md",
    "LICENSE",
    "NOTICE",
    "PUBLIC-ARCHIVE-MANIFEST.json",
    "CANONICAL-PROTOCOLS.md",
    "MCP-CAPABILITY-MATRIX.example.md",
    "mcp.json.example",
    "settings.example.json",
    "hooks.example.json",
    "CURSOR-UX.example.md",
    "CURSOR-MODELS.example.md",
    "RKX-LOOP-BLUEPRINT-FLOW.example.md"
  ],
  "public_example_roots": [
    "agents",
    "commands",
    "hooks",
    "rules",
    "scripts",
    "schemas",
    "reference",
    "skills",
    "loops",
    "vendor",
    "runtime/logs"
  ],
  "public_file_patterns": [
    "agents/*.example.md",
    "commands/*.example.md",
    "hooks/*.example.py",
    "hooks/*_example.py",
    "hooks/*.example.sh",
    "hooks/*.env.example",
    "rules/*.example.mdc",
    "scripts/**",
    "schemas/**",
    "reference/**",
    "skills/**/SKILL.example.md",
    "skills/**/project-map.example.md",
    "skills/**/recipes.example.md",
    "skills/**/project-tenets.example.md",
    "skills/refero-design/references/*.md",
    "loops/README.md",
    "loops/_decisions/**",
    "loops/*.example.md",
    "vendor/**",
    "runtime/logs/README.md"
  ],
  "public_skill_ids": [
    "browser-ui-evidence",
    "docker-diagnostics",
    "graph-octocode",
    "meta-developer-tools",
    "octocode-code-forensics",
    "orchestration-qa",
    "playwright-ui-evidence",
    "pr-review-toolkit",
    "refero-design",
    "rkx-loop-bug",
    "rkx-loop-core",
    "rkx-loop-design",
    "rkx-loop-front",
    "rkx-loop-full",
    "rkx-loop-grill-me",
    "rkx-loop-implement",
    "rkx-loop-plan",
    "rkx-loop-validate",
    "security-guidance",
    "web-artifacts-builder",
    "rkx-codegraph",
    "rkx-mcp-utilities",
    "rkx-tenets"
  ],
  "exact_public_files": [
    "assets/rkx-loop-flow.png",
    "assets/install-flow.png"
  ],
  "excluded_roots": [
    "prompts",
    "projects",
    "plans",
    "plugins",
    "subagents",
    "sandbox-policies",
    "skills-cursor"
  ],
  "excluded_path_patterns": [
    ".gitignore.example",
    "reference/blueprint-index.yaml",
    "reference/system-design-primer/README-ja.md",
    "reference/system-design-primer/README-zh-*.md",
    "reference/system-design-primer/**/README-zh-*.md",
    "reference/system-design-primer/TRANSLATIONS.md",
    "reference/system-design-primer/.github/**",
    "reference/system-design-primer/.gitignore",
    "reference/system-design-primer/generate-epub.sh",
    "reference/system-design-primer/resources/**",
    "skills/**/scripts/**",
    "loops/*/manifest.md",
    "loops/*/slack-notification.json",
    "loops/*/state.md",
    "loops/*/wave-*"
  ],
  "canonical_target_patterns": [
    "agents/*.md",
    "commands/*.md",
    "rules/*.mdc",
    "skills/**/SKILL.md",
    "skills/**/project-map.md",
    "skills/**/recipes.md",
    "skills/**/project-tenets.md",
    "hooks/*.py",
    "hooks/*.sh",
    "hooks.json",
    "mcp.json",
    "settings.json",
    "CURSOR-UX.md",
    "CURSOR-MODELS.md",
    "RKX-LOOP-BLUEPRINT-FLOW.md",
    "reference/blueprint-index.yaml",
    "scripts/*.sh"
  ],
  "required_public_files": [
    "README.md",
    "INSTALL-WITH-CURSOR.md",
    "LICENSE",
    "NOTICE",
    "PUBLIC-ARCHIVE-MANIFEST.json",
    "hooks.example.json",
    "hooks/rkx_lifecycle_common_example.py",
    "hooks/rkx_slack_notify_example.py",
    "hooks/rkx_write_easy_summary_example.py",
    "scripts/validate-public-control-plane.py",
    "scripts/stage-public-archive.py",
    "schemas/wave-spec-v1.json",
    "schemas/lifecycle-artifact-v1.json",
    "schemas/install-manifest-v1.json",
    "schemas/runtime-inputs-v1.json",
    "assets/rkx-loop-flow.png",
    "assets/install-flow.png",
    "rules/workspace-read-cache.example.mdc",
    "reference/system-design-primer/README.md",
    "reference/system-design-primer/LICENSE.txt",
    "reference/system-design-primer/.upstream-commit"
  ],
  "binary_review": [
    {
      "path": "assets/rkx-loop-flow.png",
      "sha256": "c1dfb97ab87e96255b05a520793cba75bcd482c100a55947259cd58485fd0751",
      "width": 880,
      "height": 1788,
      "review": "visual-review-complete"
    },
    {
      "path": "assets/install-flow.png",
      "sha256": "cf942d12bf1dce19e254bcf1ced4694699eafed14efef9e5dfaaa3e7d7b06a4a",
      "width": 1064,
      "height": 1478,
      "review": "visual-review-complete"
    }
  ],
  "binary_public_patterns": [
    "reference/system-design-primer/images/**",
    "reference/system-design-primer/solutions/**/*.png",
    "reference/system-design-primer/solutions/**/*.jpg",
    "reference/system-design-primer/solutions/**/*.jpeg",
    "reference/system-design-primer/solutions/**/*.graffle"
  ],
  "excluded_content": [
    "credentials",
    "runtime state",
    "personal paths",
    "legacy orchestration",
    "legacy third-party transport instructions",
    "customer or product-specific integrations",
    "non-English vendor translations"
  ],
  "required_public_checks": [
    "no tracked symlinks",
    "no Cyrillic in owned files",
    "no credential literals",
    "no host-specific absolute paths",
    "no mutable latest package tags",
    "no sample filenames in the control-plane surface",
    "all public example references resolve",
    "exact binary allowlist and recorded hashes"
  ],
  "optional_capability_policy": {
    "default": "disabled",
    "activation": "explicit_user_confirmation_after_preflight",
    "degraded_behavior": "record_unavailable_and_continue"
  }
}
