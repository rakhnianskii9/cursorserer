{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rkx-capability-preflight-v1",
  "title": "RKX CAPABILITY_PREFLIGHT v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "run_id", "phase_id", "wave_id",
    "correlation_id", "preflight_spec_revision", "revision_seq", "token_mode",
    "billing_credential_scope", "merger_decision", "slots"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "CAPABILITY_PREFLIGHT"},
    "run_id": {"type": "string", "minLength": 1},
    "phase_id": {"type": "string", "minLength": 1},
    "wave_id": {"type": "integer", "minimum": 1, "maximum": 20},
    "correlation_id": {"type": "string", "minLength": 1},
    "preflight_spec_revision": {"type": "string", "minLength": 1},
    "revision_seq": {"type": "integer", "minimum": 1},
    "token_mode": {"enum": ["API", "CURSOR"]},
    "billing_credential_scope": {"enum": ["API_CREDENTIALS", "CURSOR_SUBSCRIPTION"]},
    "merger_decision": {"enum": ["DISPATCH", "REPLAN", "WAITING_USER", "HARD_BLOCKER_CANDIDATE"]},
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id", "status", "reason", "searchability",
          "source_tool_mcp_availability", "authenticated_context",
          "read_only_scope", "correlation_refs", "revision_compatibility"
        ],
        "properties": {
          "slot_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["READY", "UNAVAILABLE", "STALE", "INVALID"]},
          "reason": {"type": ["string", "null"]},
          "searchability": {"enum": ["KNOWN", "UNKNOWN", "NOT_APPLICABLE"]},
          "source_tool_mcp_availability": {"type": "string"},
          "authenticated_context": {"type": "string"},
          "read_only_scope": {"type": ["string", "boolean"]},
          "correlation_refs": {"type": ["array", "string", "null"]},
          "revision_compatibility": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"token_mode": {"const": "API"}}, "required": ["token_mode"]},
      "then": {"properties": {"billing_credential_scope": {"const": "API_CREDENTIALS"}}}
    },
    {
      "if": {"properties": {"token_mode": {"const": "CURSOR"}}, "required": ["token_mode"]},
      "then": {"properties": {"billing_credential_scope": {"const": "CURSOR_SUBSCRIPTION"}}}
    }
  ]
}
