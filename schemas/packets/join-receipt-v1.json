{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rkx-join-receipt-v1",
  "title": "RKX JoinReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "phase_id", "wave_id", "spec_revision",
    "correlation_id", "planned_slot_ids", "accounted_slot_ids",
    "slot_receipts", "dispatch_receipts", "complete"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "phase_id": {"type": "string", "minLength": 1},
    "wave_id": {"type": "integer", "minimum": 1, "maximum": 20},
    "spec_revision": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "planned_slot_ids": {
      "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "accounted_slot_ids": {
      "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "slot_receipts": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {"$ref": "#/$defs/slotReceipt"}
    },
    "dispatch_receipts": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {"$ref": "#/$defs/dispatchReceipt"}
    },
    "complete": {"const": true}
  },
  "$defs": {
    "slotReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "phase_id", "wave_id", "spec_revision", "correlation_id",
        "slot_id", "attempt_id", "status", "report_ref", "sha256", "model"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "phase_id": {"type": "string", "minLength": 1},
        "wave_id": {"type": "integer", "minimum": 1, "maximum": 20},
        "spec_revision": {"type": "string", "minLength": 1},
        "correlation_id": {"type": "string", "minLength": 1},
        "slot_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "integer", "minimum": 1, "maximum": 5},
        "status": {"enum": ["COMPLETE", "NOT_APPLICABLE", "UNAVAILABLE", "FAILED"]},
        "report_ref": {
          "type": "string",
          "pattern": "^loops/[^/]+/wave-([1-9]|1[0-9]|20)/slots/[^/]+/attempts/[1-5]/report\\.md$"
        },
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "dispatchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "run_id", "phase_id", "wave_id", "spec_revision", "correlation_id",
        "slot_id", "transport_outcome", "attempt_id"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "phase_id": {"type": "string", "minLength": 1},
        "wave_id": {"type": "integer", "minimum": 1, "maximum": 20},
        "spec_revision": {"type": "string", "minLength": 1},
        "correlation_id": {"type": "string", "minLength": 1},
        "slot_id": {"type": "string", "minLength": 1},
        "transport_outcome": {"enum": ["RETURNED", "FAILED", "TIMED_OUT", "CANCELLED"]},
        "attempt_id": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    }
  }
}
