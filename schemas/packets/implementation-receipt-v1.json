{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rkx-implementation-receipt-v1",
  "title": "RKX ImplementationReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "run_id",
    "wave_id",
    "spec_revision",
    "decision_id",
    "status",
    "report_ref",
    "changed_files",
    "validation_notes",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "phase_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "wave_id": {"type": "integer", "minimum": 1, "maximum": 20},
    "spec_revision": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "COMPLETED",
        "FAILED"
      ]
    },
    "report_ref": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "validation_notes": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
