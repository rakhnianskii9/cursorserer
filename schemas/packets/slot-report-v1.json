{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rkx-slot-report-v1",
  "title": "RKX SlotReport frontmatter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "phase_id", "wave_id", "spec_revision",
    "correlation_id", "slot_id", "attempt_id", "hypothesis_id", "status", "fact",
    "evidence_refs", "confidence", "confidence_basis", "model",
    "next_question", "degraded"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "phase_id": {"type": "string", "minLength": 1},
    "wave_id": {"type": "integer", "minimum": 1, "maximum": 20},
    "spec_revision": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "slot_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "integer", "minimum": 1, "maximum": 5},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETE", "NOT_APPLICABLE", "UNAVAILABLE", "FAILED"]},
    "fact": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {"type": "string", "pattern": "^(100|[1-9]?\\d)%$"},
    "confidence_basis": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "next_question": {"type": ["string", "null"]},
    "degraded": {"type": ["string", "null"]}
  }
}
