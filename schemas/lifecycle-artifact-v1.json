{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cursor-control-plane/schemas/lifecycle-artifact-v1.json",
  "title": "RKX Lifecycle Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "phase_id",
    "wave_id",
    "kind",
    "notification_type",
    "waiting_reason",
    "correlation_id",
    "conversation_id",
    "problem_title",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "phase_id": {
      "type": "string",
      "minLength": 1
    },
    "wave_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "kind": {
      "enum": [
        "started",
        "progress",
        "wave_result",
        "waiting_user",
        "blocked",
        "completed",
        "failed",
        "wave_cap"
      ]
    },
    "notification_type": {
      "enum": [
        "attention",
        "result"
      ]
    },
    "waiting_reason": {
      "enum": [
        "WAVE_CAP",
        "USER_SCOPE",
        "OFF_HOST",
        null
      ]
    },
    "decision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "blocker": {
      "type": "string",
      "maxLength": 1200
    },
    "next_action": {
      "type": "string",
      "maxLength": 1200
    },
    "full_verdict_available": {
      "type": "boolean"
    },
    "full_verdict_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^\\s]+$"
    },
    "capture_dir": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$",
      "maxLength": 255
    },
    "decision_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "model": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "wave_result",
              "completed"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "notification_type": {
            "const": "result"
          },
          "waiting_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "waiting_user",
              "blocked",
              "failed",
              "wave_cap"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "notification_type": {
            "const": "attention"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "full_verdict_available": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "full_verdict_url"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "full_verdict_available": {
            "const": false
          }
        },
        "required": [
          "full_verdict_available"
        ]
      },
      "then": {
        "not": {
          "required": [
            "full_verdict_url"
          ]
        }
      }
    }
  ]
}
