# Copy to ${HOME}/.cursor/rkx-slack-notify.env and fill ONE transport.
# Never commit the real env file.
#
# Preferred (Incoming Webhook — one channel/DM destination):
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Alternative (Bot token + channel/user id):
# SLACK_BOT_TOKEN=<set-in-local-environment>
# SLACK_NOTIFY_CHANNEL=YOUR_SLACK_CHANNEL_OR_USER_ID
#
# Optional mention of the recipient to trigger a mobile push in a channel:
# SLACK_NOTIFY_MENTION='<@YOUR_SLACK_USER_ID>'
#
# Modes:
#   attention_and_result — attention cards + completed-loop result cards
#   attention            — only cards requiring USER input/decision
#   result               — only completed-loop result cards
RKX_SLACK_NOTIFY_MODE=attention_and_result
#
# Retain a delivered event for at least the notification-artifact lifetime:
RKX_SLACK_DEDUP_SEC=1800
# A pending lease suppresses concurrent stop hooks before bounded recovery:
RKX_SLACK_PENDING_SEC=120
# Ignore notification artifacts older than this window:
RKX_SLACK_NOTIFICATION_MAX_AGE_SEC=1800
